#!/bin/bash
# 卸载前执行：停止服务进程
set -u
PIDFILE="${TRIM_PKGVAR:-/var/apps/${TRIM_APPNAME:-kvmemllamacpp}/var}/server.pid"
if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        i=0
        while [ $i -lt 15 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
fi
exit 0
